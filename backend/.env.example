# Copiar este archivo como .env y completar los valores.

# Conexión a PostgreSQL: reemplazar "completar" por la contraseña del usuario postgres.
# La base foodstore_db tiene que existir antes de ejecutar el seed.
DATABASE_URL=postgresql://postgres:completar@localhost:5432/foodstore_db

# Alternativa para desarrollo local sin PostgreSQL (crea el archivo foodstore.db en la carpeta backend):
# DATABASE_URL=sqlite:///./foodstore.db

# Clave para firmar los JWT, de al menos 32 caracteres.
# Para generar una: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend habilitado en CORS
FRONTEND_ORIGIN=http://localhost:5173
